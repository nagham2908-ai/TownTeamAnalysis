# Supabase — create a project at https://supabase.com, then Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — create a free account at https://resend.com, verify a sending domain
# (resend.com/domains) so you can email addresses other than your own account email,
# then Resend → API Keys → create key.
RESEND_API_KEY=re_xxxxxxxxxxxx
# Must be an address on a domain you verified in Resend, e.g. wfc@yourdomain.com
NOTIFY_FROM_EMAIL=Town Team WFC Questionnaire <onboarding@resend.dev>
# Where the completed PDF/Word attachments are emailed on submit
NOTIFY_TO_EMAIL=nagham_mohamed@rayais.com
